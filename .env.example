# Crystal Clean - Environment Variables Configuration

# 1. Supabase Connection (Get from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Business WhatsApp Configuration (International format: 91XXXXXXXXXX without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# 3. Business Information (Editable also from Admin Settings)
NEXT_PUBLIC_BUSINESS_NAME=Crystal Clean
NEXT_PUBLIC_BUSINESS_PHONE=+91 98765 43210
NEXT_PUBLIC_BUSINESS_EMAIL=orders@crystalclean.in
NEXT_PUBLIC_BUSINESS_ADDRESS=Plot 42, Industrial Area, Phase II, New Delhi 110020, India
NEXT_PUBLIC_BUSINESS_GST=07AAAAA0000A1Z5
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. Optional Cloudflare Turnstile Spam Protection for Reviews/Inquiries
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
